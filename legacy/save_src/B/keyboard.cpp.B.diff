+// Post-load re-arm (B run). uart_rx_load/tx_load/pc98_keyboard_recv_byte are
+// NOT in the old PIC table (keyboard.cpp:2249-2289), so a restored rx_busy
+// would stick forever without this. Called at the end of pc98_sys setBytes.
+void PC98_Sys_RearmEvents(void) {
+    PIC_RemoveEvents(uart_rx_load);
+    PIC_RemoveEvents(uart_tx_load);
+    PIC_RemoveEvents(pc98_keyboard_recv_byte);
+    // §4.2-12: type-ahead beyond the in-flight byte is dropped (host key
+    // state is outside save scope). recv_out still points at the in-flight
+    // slot, so a re-armed delivery below reads the right byte.
+    pc98_8251_keyboard_uart_state.recv_in = pc98_8251_keyboard_uart_state.recv_out;
+    if (pc98_8251_keyboard_uart_state.rx_busy && !pc98_8251_keyboard_uart_state.rx_ready) {
+        PIC_AddEvent(uart_rx_load, pc98_8251_keyboard_uart_state.io_delay_ms, 0);
+    } else {
+        // Nothing in flight (or byte already in `data`): clear stuck flag.
+        pc98_8251_keyboard_uart_state.rx_busy = false;
+    }
+    if (pc98_8251_keyboard_uart_state.tx_busy) {
+        PIC_AddEvent(uart_tx_load, pc98_8251_keyboard_uart_state.tx_load_ms, 0);
+        PIC_AddEvent(pc98_keyboard_recv_byte, pc98_8251_keyboard_uart_state.io_delay_ms,
+            pc98_8251_keyboard_uart_state.txdata);
+    }
+}
