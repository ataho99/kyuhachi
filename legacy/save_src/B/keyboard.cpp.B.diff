+// 8255 value members only (const char* names excluded). Both 8255s are
+// static class instances (keyboard.cpp:2023,2132), so save goes through here.
+static void PC98_8255_SaveBody(const Intel8255& c, std::ostream& stream) {
+    WRITE_POD(&c.latchOutPortA, c.latchOutPortA);
+    WRITE_POD(&c.latchOutPortB, c.latchOutPortB);
+    WRITE_POD(&c.latchOutPortC, c.latchOutPortC);
+    WRITE_POD(&c.mode, c.mode);
+    WRITE_POD(&c.portAWriteMask, c.portAWriteMask);
+    WRITE_POD(&c.portBWriteMask, c.portBWriteMask);
+    WRITE_POD(&c.portCWriteMask, c.portCWriteMask);
+    WRITE_POD(&c.IBF_A, c.IBF_A);
+    WRITE_POD(&c.IBF_B, c.IBF_B);
+    WRITE_POD(&c.OBF_A, c.OBF_A);
+    WRITE_POD(&c.OBF_B, c.OBF_B);
+    WRITE_POD(&c.INTR_A, c.INTR_A);
+    WRITE_POD(&c.INTR_B, c.INTR_B);
+    WRITE_POD(&c.pINTR_A, c.pINTR_A);
+    WRITE_POD(&c.pINTR_B, c.pINTR_B);
+    WRITE_POD(&c.INTE_1, c.INTE_1);
+    WRITE_POD(&c.INTE_2, c.INTE_2);
+    WRITE_POD(&c.INTE_A, c.INTE_A);
+    WRITE_POD(&c.INTE_B, c.INTE_B);
+}
+
+static void PC98_8255_LoadBody(Intel8255& c, std::istream& stream) {
+    // Direct member restore (no outPortC call): SHUT0/1 side effects are
+    // saved separately, speaker inhibit stays with the Keyboard component.
+    READ_POD(&c.latchOutPortA, c.latchOutPortA);
+    READ_POD(&c.latchOutPortB, c.latchOutPortB);
+    READ_POD(&c.latchOutPortC, c.latchOutPortC);
+    READ_POD(&c.mode, c.mode);
+    READ_POD(&c.portAWriteMask, c.portAWriteMask);
+    READ_POD(&c.portBWriteMask, c.portBWriteMask);
+    READ_POD(&c.portCWriteMask, c.portCWriteMask);
+    READ_POD(&c.IBF_A, c.IBF_A);
+    READ_POD(&c.IBF_B, c.IBF_B);
+    READ_POD(&c.OBF_A, c.OBF_A);
+    READ_POD(&c.OBF_B, c.OBF_B);
+    READ_POD(&c.INTR_A, c.INTR_A);
+    READ_POD(&c.INTR_B, c.INTR_B);
+    READ_POD(&c.pINTR_A, c.pINTR_A);
+    READ_POD(&c.pINTR_B, c.pINTR_B);
+    READ_POD(&c.INTE_1, c.INTE_1);
+    READ_POD(&c.INTE_2, c.INTE_2);
+    READ_POD(&c.INTE_A, c.INTE_A);
+    READ_POD(&c.INTE_B, c.INTE_B);
+}
